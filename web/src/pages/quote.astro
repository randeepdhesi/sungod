---
import QuoteSection from '../components/quote/QuoteSection.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import TextTrio from '../components/ui/TextTrio.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const nextSteps = [
  { title: 'We call you back', body: 'Usually within one business day, to learn about your home and book a visit.' },
  { title: 'In-home consultation', body: 'We measure, bring fabric samples and plan controls around how you live.' },
  { title: 'A clear written quote', body: 'Products, motors, controls and installation, all itemized. No pressure.' }
];
---

<BaseLayout title="Get a Quote" description="Request a free consultation and quote for motorized blinds, shades or Phantom screens in Vancouver and the Lower Mainland.">
  <QuoteSection headingLevel="h1" title="Get a Quote" />
  <Section tone="lace" pad="md">
    <Container>
      <SectionHeading title="What happens next" />
      <TextTrio items={nextSteps} class="mt-14" />
    </Container>
  </Section>
</BaseLayout>
