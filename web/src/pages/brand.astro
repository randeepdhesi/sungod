---
import BrandConceptSheet from '../components/brand/BrandConceptSheet.astro';
import BrandReviewTool from '../components/brand/BrandReviewTool.astro';
import Swatch from '../components/brand/Swatch.astro';
import BrandConceptsGrid from '../components/home/BrandConceptsGrid.astro';
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import { logoConcepts, palette } from '../data/brand';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Brand Concepts Review Suite" description="Interactive logo concept review and real-world mockups for Sungod Blinds." noindex>
  <Section tone="lace" pad="md" class="pb-6! md:pb-8!">
    <Container>
      <p class="text-[13px] font-semibold tracking-[0.06em] text-spice uppercase" data-reveal>Sungod Blinds · Identity Review Suite</p>
      <h1 class="mt-4 max-w-[16ch] text-display" data-reveal>Sungod brand identity review.</h1>
      <p class="mt-6 max-w-[58ch] text-lg text-mist" data-reveal>
        Explore the 3 original vector directions below. Select a direction to preview how it looks on commercial vehicle decals, business cards, swatch tags, and in the live website header.
      </p>
    </Container>
  </Section>

  <Section tone="lace" pad="md" class="pt-0! md:pt-0!">
    <Container>
      <BrandReviewTool />
    </Container>
  </Section>

  <BrandConceptsGrid headingLevel="h2" showLink={false} title="Identity Geometry Breakdown" />

  {logoConcepts.map((concept, i) => <BrandConceptSheet concept={concept} tone={i % 2 === 0 ? 'band' : 'lace'} />)}

  <Section tone="band" pad="md">
    <Container class="grid gap-16 lg:grid-cols-2">
      <div>
        <h2 class="text-h2" data-reveal>Palette</h2>
        <ul class="mt-10 grid gap-6 sm:grid-cols-2">
          {palette.map((s) => <Swatch swatch={s} />)}
        </ul>
      </div>
      <div>
        <h2 class="text-h2" data-reveal>Typography</h2>
        <div class="mt-10 space-y-8">
          <div class="border-t border-line pt-6">
            <p class="font-display text-[96px] leading-none">Aa</p>
            <p class="mt-3 text-[14px] text-mist">Forum · wordmark and headlines</p>
          </div>
          <div class="border-t border-line pt-6">
            <p class="text-2xl font-normal">Mastering light, room by room.</p>
            <p class="text-2xl font-medium">Mastering light, room by room.</p>
            <p class="text-2xl font-bold">Mastering light, room by room.</p>
            <p class="mt-3 text-[14px] text-mist">Inter 400 / 500 / 700 · high-legibility body, navigation and forms</p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section tone="lace" pad="md">
    <Container class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-h2">Next step</h2>
        <p class="mt-4 max-w-[52ch] text-mist">
          Pick a direction and we'll refine it, outline the lettering and export SVG, PNG, favicon and social images.
        </p>
      </div>
      <Button href="/" variant="ghost" size="lg">Back to the site</Button>
    </Container>
  </Section>
</BaseLayout>
