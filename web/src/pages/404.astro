---
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <Section tone="lace" pad="lg">
    <Container>
      <p class="text-[13px] font-medium text-mist">404</p>
      <h1 class="mt-5 max-w-[14ch] text-display">This page let the light out.</h1>
      <p class="mt-8 max-w-[44ch] text-lg text-mist">The page you were looking for has moved or never existed.</p>
      <div class="mt-10"><Button href="/" size="lg">Back to home</Button></div>
    </Container>
  </Section>
</BaseLayout>
