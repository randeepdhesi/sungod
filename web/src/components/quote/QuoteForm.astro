---
import { interestOptions } from '../../data/products';
import Field from '../ui/Field.astro';
import SelectField from '../ui/SelectField.astro';
import TextareaField from '../ui/TextareaField.astro';
---

<div data-quote-root>
  <form data-quote-form novalidate class="grid gap-6" aria-describedby="quote-required-note">
    <div data-quote-fields class="grid gap-6">
      <p id="quote-required-note" class="text-[13px] text-mist">
        Fields marked <span class="text-spice">*</span> are required.
      </p>
      <div class="grid gap-6 md:grid-cols-2">
        <Field name="name" label="Full name" required autocomplete="name" />
        <Field name="email" label="Email" type="email" required autocomplete="email" inputmode="email" />
        <Field name="phone" label="Phone" type="tel" required autocomplete="tel" inputmode="tel" />
        <Field name="postal" label="Postal code" required autocomplete="postal-code" maxlength={7} placeholder="V6B 1A1" />
        <SelectField name="interest" label="Product interest" options={interestOptions} placeholder="Select a product" required />
        <Field name="windows" label="Number of windows" type="number" inputmode="numeric" min={1} max={200} placeholder="e.g. 8" />
      </div>
      <TextareaField name="notes" label="Tell us about your space" placeholder="Rooms, window sizes, anything you'd like us to know." />

      <!-- Honeypot: leave empty -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="field-company">Company</label>
        <input id="field-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>

    <div class="flex justify-center">
      <button
        type="submit"
        data-submit
        class="relative flex h-14 w-full items-center justify-center overflow-hidden rounded-btn bg-spice text-[15px] font-medium tracking-[0.04em] text-lace hover:bg-spice-deep"
      >
        <span data-submit-label>Request Consultation</span>
        <svg data-submit-check viewBox="0 0 24 24" width="24" height="24" class="absolute opacity-0" aria-hidden="true">
          <path
            data-check-path
            d="M5 12.5l4.5 4.5L19 7.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            pathLength="1"
            stroke-dasharray="1"
            stroke-dashoffset="1"></path>
        </svg>
      </button>
    </div>
  </form>

  <div data-quote-success role="status" aria-live="polite" tabindex="-1" hidden class="py-10 focus:outline-none">
    <p class="font-display text-[40px] leading-none">Thank you.</p>
    <p class="mt-4 max-w-[40ch] text-mist">Brent will be in touch, usually within one business day, to book your consultation.</p>
  </div>
</div>

<script>
  import '../../scripts/quote-form';
</script>
