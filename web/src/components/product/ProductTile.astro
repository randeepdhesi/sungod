---
import type { Product } from '../../data/types';
import Icon from '../ui/Icon.astro';
import PlasterTile from '../ui/PlasterTile.astro';
import StockImage from '../ui/StockImage.astro';

interface Props {
  product: Product;
  size?: 'lg' | 'sm';
  class?: string;
  revealDelay?: number;
}

const { product, size = 'sm', class: cls, revealDelay = 0 } = Astro.props;
---

<a
  href={`/products/${product.slug}`}
  class:list={['group relative block min-h-[320px] overflow-hidden rounded-card bg-band', cls]}
  data-reveal
  data-reveal-delay={String(revealDelay)}
>
  <StockImage
    image={product.tileImage}
    sizes={size === 'lg' ? '(min-width: 1024px) 66vw, 100vw' : '(min-width: 1024px) 33vw, 100vw'}
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]"
  />
  <PlasterTile class:list={['absolute bottom-4 left-4 right-4', size === 'lg' ? 'md:right-auto md:max-w-sm' : '']}>
    <h3 class:list={['leading-none', size === 'lg' ? 'text-[28px] md:text-[34px]' : 'text-[24px]']}>
      {product.shortName}
    </h3>
    <p class="mt-2 text-[14px] leading-snug text-mist">{product.tagline}</p>
    <span class="mt-4 inline-flex items-center gap-2 text-[14px] font-medium text-graphite">
      Explore
      <Icon name="arrow-right-light" size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
    </span>
  </PlasterTile>
</a>
