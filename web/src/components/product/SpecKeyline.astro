---
import type { ImageAsset, Spec } from '../../data/types';
import Container from '../ui/Container.astro';
import KeylineFrame from '../ui/KeylineFrame.astro';
import Section from '../ui/Section.astro';
import StockImage from '../ui/StockImage.astro';

interface Props {
  specs: Spec[];
  image: ImageAsset;
  title?: string;
}

const { specs, image, title = 'Specifications' } = Astro.props;
const hasDraftValues = specs.some((s) => s.confirm);
---

<Section tone="lace" pad="lg">
  <Container class="grid items-center gap-12 md:grid-cols-2 lg:gap-20">
    <div data-slide="left">
      <StockImage image={image} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[4/5] w-full rounded-card object-cover" />
    </div>
    <div>
      <h2 class="text-h2" data-reveal>{title}</h2>
      <KeylineFrame fill="band" class="mt-10" data-reveal data-reveal-delay="0.08">
        <dl>
          {
            specs.map((s) => (
              <div class="grid grid-cols-[110px_1fr] gap-4 border-b border-line py-3.5 first:pt-0 last:border-b-0 last:pb-0 sm:grid-cols-[140px_1fr]">
                <dt class="text-[13px] font-semibold text-graphite">{s.label}</dt>
                <dd class="text-[15px] text-mist">
                  {s.value}
                  {s.confirm && (
                    <span class="text-spice" aria-label="draft value">
                      {' '}*
                    </span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </KeylineFrame>
      {hasDraftValues && <p class="mt-4 text-[13px] text-mist"><span class="text-spice">*</span> Draft values, to be confirmed.</p>}
    </div>
  </Container>
</Section>
