---
import type { SectionTone } from '../../data/enums';
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';

interface Props {
  href?: string;
  title?: string;
  body?: string;
  tone?: SectionTone;
}

const {
  href = '/quote',
  title = 'Ready for automated light?',
  body = 'Book a free in-home consultation. We measure, recommend and quote, with no pressure.',
  tone = 'lace'
} = Astro.props;
---

<Section tone={tone} pad="sm">
  <Container class="flex flex-col gap-8 border-t border-line pt-12 md:flex-row md:items-end md:justify-between">
    <div data-reveal>
      <h2 class="max-w-[18ch] text-[clamp(2rem,4vw,2.75rem)] leading-[1.05]">{title}</h2>
      <p class="mt-4 max-w-[48ch] text-mist">{body}</p>
    </div>
    <div class="flex flex-wrap items-center gap-6" data-reveal data-reveal-delay="0.08">
      <a href={`tel:${site.phoneTel}`} class="text-[15px] text-mist hover:text-graphite">C {site.phoneDisplay}</a>
      <Button href={href} size="lg">Get a Quote</Button>
    </div>
  </Container>
</Section>
