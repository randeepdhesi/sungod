---
import LogoHorizon from './LogoHorizon.astro';
import LogoRadiant from './LogoRadiant.astro';
import LogoSlatted from './LogoSlatted.astro';

interface Props {
  class?: string;
  tone?: 'light' | 'dark';
}

const { class: cls, tone = 'light' } = Astro.props;
---

<span data-site-wordmark class:list={['inline-flex items-center', cls]}>
  <span data-mark-a hidden class="inline-flex items-center">
    <LogoHorizon variant="compact" tone={tone} size={15} />
  </span>
  <span data-mark-b class="inline-flex items-center">
    <LogoSlatted variant="compact" tone={tone} size={15} />
  </span>
  <span data-mark-c hidden class="inline-flex items-center">
    <LogoRadiant variant="compact" tone={tone} size={15} />
  </span>
</span>

<script>
  function applyActiveBrandMark() {
    const saved = localStorage.getItem('sungod_active_logo') || new URLSearchParams(window.location.search).get('logo') || 'B';
    const choice = (saved || 'B').toUpperCase();
    if (!['A', 'B', 'C'].includes(choice)) return;

    document.querySelectorAll('[data-site-wordmark]').forEach((root) => {
      const a = root.querySelector('[data-mark-a]');
      const b = root.querySelector('[data-mark-b]');
      const c = root.querySelector('[data-mark-c]');
      if (a) (a as HTMLElement).hidden = choice !== 'A';
      if (b) (b as HTMLElement).hidden = choice !== 'B';
      if (c) (c as HTMLElement).hidden = choice !== 'C';
    });
  }

  applyActiveBrandMark();
  window.addEventListener('storage', applyActiveBrandMark);
  window.addEventListener('sungod-brand-changed', applyActiveBrandMark);
</script>
