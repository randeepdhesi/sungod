---
import type { LogoTone, LogoVariant } from '../../data/enums';

interface Props {
  variant?: LogoVariant;
  tone?: LogoTone;
  size?: number;
  class?: string;
  title?: string;
}

const {
  variant = 'full',
  tone = 'light',
  size = 20,
  class: cls,
  title = 'Sungod Blinds logo concept A: Solstice'
} = Astro.props;

const ink = tone === 'dark' ? 'var(--color-lace)' : 'var(--color-graphite)';
const markH = variant === 'full' ? size * 3.4 : variant === 'compact' ? size * 1.6 : size;
const gap = variant === 'compact' ? size * 0.6 : size * 1;
const wordSize = variant === 'full' ? size * 1.35 : size * 0.95;
---

<div
  role="img"
  aria-label={title}
  class:list={['inline-flex', variant === 'full' ? 'flex-col items-center' : 'items-center', cls]}
  style={`color:${ink};gap:${gap}px`}
>
  <svg viewBox="0 0 64 64" width={markH} height={markH} aria-hidden="true" focusable="false">
    <!-- Outer delicate hairline orbit ring -->
    <circle cx="32" cy="32" r="29" fill="none" stroke="var(--color-honey)" stroke-width="1" opacity="0.45" />

    <!-- Inner concentric calibrated orbit ring -->
    <circle cx="32" cy="32" r="15" fill="none" stroke="var(--color-honey)" stroke-width="0.8" opacity="0.5" />

    <!-- Central golden sun disc -->
    <circle cx="32" cy="32" r="10" fill="var(--color-honey)" />

    <!-- 4 Cardinal precision rays (primary axis) -->
    <line x1="32" y1="4.5" x2="32" y2="13" stroke="var(--color-honey)" stroke-width="2.2" stroke-linecap="round" />
    <line x1="32" y1="51" x2="32" y2="59.5" stroke="var(--color-honey)" stroke-width="2.2" stroke-linecap="round" />
    <line x1="4.5" y1="32" x2="13" y2="32" stroke="var(--color-honey)" stroke-width="2.2" stroke-linecap="round" />
    <line x1="51" y1="32" x2="59.5" y2="32" stroke="var(--color-honey)" stroke-width="2.2" stroke-linecap="round" />

    <!-- 4 Diagonal precision rays (secondary axis) -->
    <line x1="21" y1="21" x2="16" y2="16" stroke="var(--color-honey)" stroke-width="1.8" stroke-linecap="round" />
    <line x1="43" y1="21" x2="48" y2="16" stroke="var(--color-honey)" stroke-width="1.8" stroke-linecap="round" />
    <line x1="21" y1="43" x2="16" y2="48" stroke="var(--color-honey)" stroke-width="1.8" stroke-linecap="round" />
    <line x1="43" y1="43" x2="48" y2="48" stroke="var(--color-honey)" stroke-width="1.8" stroke-linecap="round" />
  </svg>

  {
    variant === 'full' ? (
      <span aria-hidden="true" class="flex flex-col items-center leading-none text-center">
        <span class="font-light font-sans" style={`font-size:${wordSize}px;letter-spacing:0.38em;padding-left:0.38em`}>
          SUNGOD
        </span>
        <span class="mt-2.5 font-semibold font-sans text-spice uppercase" style={`font-size:${Math.max(wordSize * 0.44, 11)}px;letter-spacing:0.3em;padding-left:0.3em`}>
          BLINDS
        </span>
      </span>
    ) : variant !== 'mark' ? (
      <span aria-hidden="true" class="flex items-center font-sans leading-none" style={`font-size:${wordSize}px`}>
        <span class="font-light" style="letter-spacing:0.42em">
          SUNGOD
        </span>
        <span class="mx-[0.5em] h-[0.95em] w-px bg-current opacity-40" />
        <span class="font-semibold" style="letter-spacing:0.3em">
          BLINDS
        </span>
      </span>
    ) : null
  }
</div>
