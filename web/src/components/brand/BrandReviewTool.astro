---
import { site } from '../../data/site';
import Icon from '../ui/Icon.astro';
import LogoHorizon from './LogoHorizon.astro';
import LogoRadiant from './LogoRadiant.astro';
import LogoSlatted from './LogoSlatted.astro';
---

<div data-brand-review class="space-y-12">
  <!-- Concept Selection Selector Bar -->
  <div class="rounded-card border-2 border-spice/40 bg-paper p-6 md:p-8">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <span class="text-[12px] font-semibold tracking-[0.08em] text-spice uppercase">Brand Identity Review Suite</span>
        <h2 class="mt-1 font-display text-2xl md:text-3xl text-graphite">Select an identity to preview in real-world context:</h2>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-apply-site-logo
          class="inline-flex h-11 items-center gap-2 rounded-btn bg-graphite px-4 text-[13px] font-medium text-lace transition hover:bg-spice"
        >
          <Icon name="sparkle-light" size={17} />
          <span>Apply to Site Header</span>
        </button>
      </div>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-3">
      <button
        type="button"
        data-brand-select="A"
        class="flex flex-col rounded-card border border-line bg-lace/50 p-4 text-left transition hover:border-spice"
        aria-pressed="false"
      >
        <span class="font-display text-lg text-graphite">Direction A · Solstice</span>
        <span class="mt-1 text-[12px] text-mist">Precision solar compass with calibrated rays and outer orbit. Clean and balanced.</span>
      </button>

      <button
        type="button"
        data-brand-select="B"
        class="flex flex-col rounded-card border border-spice bg-paper p-4 text-left transition hover:border-spice"
        aria-pressed="true"
      >
        <span class="font-display text-lg text-graphite">Direction B · Slatted Sun</span>
        <span class="mt-1 text-[12px] text-mist">Light passing through falling slats. Pure geometric automation.</span>
      </button>

      <button
        type="button"
        data-brand-select="C"
        class="flex flex-col rounded-card border border-line bg-lace/50 p-4 text-left transition hover:border-spice"
        aria-pressed="false"
      >
        <span class="font-display text-lg text-graphite">Direction C · Fine-line Radiant</span>
        <span class="mt-1 text-[12px] text-mist">Refined ring of fine rays with classic wide serif. High-end heritage.</span>
      </button>
    </div>
  </div>

  <!-- Real-World Mockup Arena -->
  <div>
    <div class="flex items-baseline justify-between border-b border-line pb-4">
      <span class="text-[12px] font-semibold tracking-[0.08em] text-mist uppercase">Real-World Brand Applications</span>
      <span class="text-[13px] text-mist">Live mockup preview for Concept <strong data-active-letter class="text-spice">B</strong> (<span data-active-name>Slatted Sun</span>)</span>
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <!-- Mockup 1: Commercial Service Sprinter Van Decal -->
      <div class="flex flex-col justify-between overflow-hidden rounded-card border border-line bg-[#1e2022] p-6 text-lace sm:p-8">
        <div>
          <div class="flex items-center justify-between text-[11px] font-semibold tracking-[0.08em] text-lace/60 uppercase">
            <span>Fleet Vehicle Decal</span>
            <span>Matte Charcoal Van</span>
          </div>

          <!-- Van Outline Illustration -->
          <div class="relative my-8 rounded-card border border-lace/15 bg-[#17181a] p-6 sm:p-8">
            <div class="flex flex-col items-center justify-center py-6 text-center">
              <div data-mockup-a hidden>
                <LogoHorizon variant="full" tone="dark" size={17} />
              </div>
              <div data-mockup-b>
                <LogoSlatted variant="full" tone="dark" size={17} />
              </div>
              <div data-mockup-c hidden>
                <LogoRadiant variant="full" tone="dark" size={17} />
              </div>

              <div class="mt-6 border-t border-lace/20 pt-4 text-center">
                <p class="font-sans text-[12px] tracking-[0.14em] text-lace/80 uppercase">Motorized Window Coverings · Metro Vancouver</p>
                <p class="mt-1 font-display text-lg text-honey">{site.phoneDisplay} · sungodblinds.ca</p>
              </div>
            </div>

            <!-- Stylized Van Base Wheels -->
            <div class="mt-4 flex items-center justify-between border-t border-lace/10 pt-4 text-[11px] text-lace/40">
              <span>Van Side Panel Mockup</span>
              <span>Reflective Metallic Gold Foil</span>
            </div>
          </div>
        </div>

        <p class="text-[12px] text-lace/70">
          Clean, authoritative presence on roads and client driveways across Vancouver, West Van, and the Fraser Valley.
        </p>
      </div>

      <!-- Mockup 2: Debossed Cotton Business Card -->
      <div class="flex flex-col justify-between rounded-card border border-line bg-paper p-6 sm:p-8">
        <div>
          <div class="flex items-center justify-between text-[11px] font-semibold tracking-[0.08em] text-mist uppercase">
            <span>Client Consultation Card</span>
            <span>Letterpress 600gsm Cotton</span>
          </div>

          <!-- Card visual -->
          <div class="relative my-8 rounded-card border border-line/80 bg-lace p-7 shadow-inner">
            <div class="flex items-start justify-between">
              <div>
                <div data-mockup-a hidden>
                  <LogoHorizon variant="compact" size={14} />
                </div>
                <div data-mockup-b>
                  <LogoSlatted variant="compact" size={14} />
                </div>
                <div data-mockup-c hidden>
                  <LogoRadiant variant="compact" size={14} />
                </div>
                <p class="mt-4 text-[12px] text-mist">{site.region}</p>
              </div>

              <div class="text-right">
                <p class="font-display text-lg leading-tight text-graphite">Technical Team</p>
                <p class="text-[12px] font-medium text-spice">In-House Measurement &amp; Craft</p>
              </div>
            </div>

            <div class="mt-8 border-t border-line/60 pt-4 text-[12px] text-mist">
              <p>Direct: {site.phoneDisplay}</p>
              <p>Web: {site.domain}</p>
            </div>
          </div>
        </div>

        <p class="text-[12px] text-mist">
          Debossed copper-foil hot stamp on 600gsm natural warm cotton card stock for architect &amp; homeowner hand-offs.
        </p>
      </div>

      <!-- Mockup 3: In-Home Consultation Laser Spec Sheet -->
      <div class="flex flex-col justify-between rounded-card border border-line bg-paper p-6 sm:p-8">
        <div>
          <div class="flex items-center justify-between text-[11px] font-semibold tracking-[0.08em] text-mist uppercase">
            <span>Written Consultation Proposal</span>
            <span>Laser Measure Itemization</span>
          </div>

          <div class="my-6 rounded-card border border-line/80 bg-lace/30 p-5 text-[13px] text-graphite">
            <div class="flex items-center justify-between border-b border-line pb-4">
              <div data-mockup-a hidden>
                <LogoHorizon variant="compact" size={13} />
              </div>
              <div data-mockup-b>
                <LogoSlatted variant="compact" size={13} />
              </div>
              <div data-mockup-c hidden>
                <LogoRadiant variant="compact" size={13} />
              </div>
              <span class="text-[12px] text-mist">Proposal #2026-081</span>
            </div>

            <div class="mt-3 space-y-1 text-[12px] text-mist">
              <p><strong>Prepared for:</strong> Residential Client · Point Grey Residence</p>
              <p><strong>Measured by:</strong> Sungod Technical Crew · Accuracy: ±1/16"</p>
              <p><strong>Scope:</strong> 8× Motorized Roller Shades (Li-ion Rechargeable) + Somfy Bridge</p>
            </div>
          </div>
        </div>

        <p class="text-[12px] text-mist">
          Architectural presentation on all client estimates, specification sheets, and manufacturer work orders.
        </p>
      </div>

      <!-- Mockup 4: Fabric Ring Sample Swatch Tag -->
      <div class="flex flex-col justify-between rounded-card border border-line bg-paper p-6 sm:p-8">
        <div>
          <div class="flex items-center justify-between text-[11px] font-semibold tracking-[0.08em] text-mist uppercase">
            <span>Fabric Swatch Ring Tag</span>
            <span>Brass Eyelet Stamped</span>
          </div>

          <div class="my-6 flex items-center justify-center rounded-card border border-line/80 bg-lace/40 p-8">
            <div class="w-full max-w-xs rounded-card border border-line bg-paper p-5 text-center shadow-xs">
              <div class="mx-auto mb-3 flex h-4 w-4 items-center justify-center rounded-full border border-line bg-line/30">
                <span class="h-1.5 w-1.5 rounded-full bg-mist"></span>
              </div>
              <div data-mockup-a hidden class="flex justify-center">
                <LogoHorizon variant="full" size={14} />
              </div>
              <div data-mockup-b class="flex justify-center">
                <LogoSlatted variant="full" size={14} />
              </div>
              <div data-mockup-c hidden class="flex justify-center">
                <LogoRadiant variant="full" size={14} />
              </div>
              <div class="mt-4 border-t border-line/60 pt-3 text-[11px] text-mist">
                <p class="font-medium text-graphite">Architectural Collection</p>
                <p>3% Solar Screen · Light-Filtering · Blackout</p>
              </div>
            </div>
          </div>
        </div>

        <p class="text-[12px] text-mist">
          Branded header tags attached to fabric swatch books that homeowners browse during in-home consultations.
        </p>
      </div>
    </div>
  </div>

  <!-- One-Click Decision Feedback Tool -->
  <div class="rounded-card border-2 border-line bg-lace p-6 md:p-10">
    <div class="max-w-[50ch]">
      <span class="text-[12px] font-semibold tracking-[0.08em] text-spice uppercase">Ready to share your decision?</span>
      <h3 class="mt-1 font-display text-2xl md:text-3xl text-graphite">Send your preferred direction to Randeep:</h3>
      <p class="mt-2 text-[14px] text-mist">
        Click below to copy your feedback message with your selected concept. You can paste it into an email or text message!
      </p>
    </div>

    <div class="mt-6 max-w-2xl space-y-4">
      <textarea
        data-feedback-text
        rows="3"
        class="deboss-well w-full p-4 text-[14px] text-graphite focus:outline-none"
      ></textarea>

      <div class="flex flex-wrap items-center gap-4">
        <button
          type="button"
          data-copy-feedback
          class="inline-flex h-12 items-center gap-2 rounded-btn bg-spice px-6 text-[14px] font-medium tracking-[0.04em] text-lace shadow-sm transition hover:bg-spice-deep"
        >
          <Icon name="copy-light" size={18} />
          <span>Copy Feedback for Randeep</span>
        </button>

        <a
          href="/"
          class="inline-flex h-12 items-center gap-2 rounded-btn border border-line bg-paper px-5 text-[14px] font-medium text-graphite transition hover:border-graphite"
        >
          <span>Preview Active Logo on Homepage →</span>
        </a>
      </div>

      <p data-copy-status hidden class="text-[14px] font-medium text-spice"></p>
    </div>
  </div>
</div>

<script>
  import { initBrandReview } from '../../scripts/brand-review';

  document.querySelectorAll<HTMLElement>('[data-brand-review]').forEach((el) => {
    initBrandReview(el);
  });
</script>
