---
import type { LogoTone, LogoVariant } from '../../data/enums';
import { radialLines } from '../../lib/logo-geometry';

interface Props {
  variant?: LogoVariant;
  tone?: LogoTone;
  size?: number;
  class?: string;
  title?: string;
}

const {
  variant = 'full',
  tone = 'light',
  size = 20,
  class: cls,
  title = 'Sungod Blinds logo concept C: Fine-line Radiant'
} = Astro.props;

const rays = radialLines(50, 50, 24, 21, 35, 28.5);
const ink = tone === 'dark' ? 'var(--color-lace)' : 'var(--color-graphite)';
const markH = variant === 'full' ? size * 3.6 : variant === 'compact' ? size * 1.7 : size;
const gap = variant === 'compact' ? size * 0.55 : size * 0.9;
---

<div
  role="img"
  aria-label={title}
  class:list={['inline-flex', variant === 'full' ? 'flex-col items-center' : 'items-center', cls]}
  style={`color:${ink};gap:${gap}px`}
>
  <svg viewBox="0 0 100 100" width={markH} height={markH} aria-hidden="true" focusable="false">
    <g stroke="var(--color-honey)" fill="none" stroke-linecap="round">
      <circle cx="50" cy="50" r="15.5" stroke-width="1.5"></circle>
      <circle cx="50" cy="50" r="10" stroke-width="0.6" opacity="0.5"></circle>
      {rays.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke-width="1.3" />)}
    </g>
  </svg>
  {
    variant !== 'mark' && (
      <span aria-hidden="true" class:list={['flex flex-col', variant === 'full' ? 'items-center' : 'items-start']}>
        <span
          class="font-display leading-none"
          style={`font-size:${variant === 'full' ? size * 1.8 : size * 1.1}px;letter-spacing:0.55em;padding-left:${variant === 'full' ? '0.55em' : '0'}`}
        >
          SUNGOD
        </span>
        {variant === 'full' && (
          <span
            class="font-sans font-semibold text-spice uppercase leading-none"
            style={`font-size:${Math.max(size * 0.44, 11)}px;letter-spacing:0.3em;padding-left:0.3em;margin-top:8px`}
          >
            BLINDS
          </span>
        )}
      </span>
    )
  }
</div>
