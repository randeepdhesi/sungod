---
import { products } from '../../data/products';
import { primaryNav, site } from '../../data/site';
import SiteWordmark from '../brand/SiteWordmark.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';

const path = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const onProducts = path.startsWith('/products');
---

<header
  data-site-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-lace data-scrolled:border-line data-scrolled:bg-paper"
>
  <Container size="wide" class="flex h-20 items-center justify-between gap-6">
    <a href="/" aria-label="Sungod Blinds home" class="flex items-center text-graphite">
      <SiteWordmark class="scale-110 sm:scale-120 lg:scale-100 transition-transform origin-left" />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-10 text-[14px] font-medium">
        <li class="relative">
          <button
            type="button"
            data-products-toggle
            aria-expanded="false"
            aria-controls="products-menu"
            class:list={[
              'flex items-center gap-1.5 py-2 hover:text-spice',
              onProducts && 'underline decoration-honey decoration-2 underline-offset-[10px]'
            ]}
          >
            Products
            <Icon name="caret-down-light" size={14} />
          </button>
          <div
            id="products-menu"
            hidden
            class="absolute left-1/2 top-[calc(100%+22px)] w-[22rem] -translate-x-1/2 rounded-card border border-line bg-paper p-2"
          >
            <ul>
              {
                products.map((p) => (
                  <li>
                    <a
                      href={`/products/${p.slug}`}
                      aria-current={isCurrent(`/products/${p.slug}`) ? 'page' : undefined}
                      class="block rounded-input px-4 py-3 hover:bg-lace aria-[current=page]:bg-lace"
                    >
                      <span class="block font-display text-xl leading-tight text-graphite">{p.shortName}</span>
                      <span class="mt-0.5 block text-[13px] font-normal text-mist">{p.tagline}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          primaryNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="py-2 hover:text-spice aria-[current=page]:underline aria-[current=page]:decoration-honey aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[10px]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <div class="header-cta-desktop hidden lg:block">
        <Button href={site.cta.href} class="whitespace-nowrap">{site.cta.label}</Button>
      </div>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open navigation menu"
        class="inline-flex h-11 w-11 items-center justify-center rounded-btn border border-line bg-paper text-graphite shadow-xs transition hover:border-spice focus:outline-none lg:hidden shrink-0"
      >
        <div class="relative flex h-3.5 w-4 flex-col justify-between" aria-hidden="true">
          <span class="bar-top h-0.5 w-full rounded-full bg-graphite transition-all duration-300 ease-out origin-center"></span>
          <span class="bar-mid h-0.5 w-full rounded-full bg-graphite transition-all duration-200 ease-out origin-center"></span>
          <span class="bar-bot h-0.5 w-full rounded-full bg-graphite transition-all duration-300 ease-out origin-center"></span>
        </div>
      </button>
    </div>
  </Container>

  <div
    id="mobile-nav"
    hidden
    class="fixed inset-x-0 top-20 h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain border-t border-line bg-lace lg:hidden"
  >
    <Container class="flex min-h-full flex-col justify-between py-6 pb-20">
      <nav aria-label="Mobile" class="flex flex-col">
        <div>
          <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-spice">Products</p>
          <ul class="mt-2 border-b border-line pb-3">
            {
              products.map((p) => (
                <li>
                  <a href={`/products/${p.slug}`} class="block py-2 font-display text-2xl text-graphite hover:text-spice transition-colors">
                    {p.shortName}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/phantom-screens" class="block py-2 font-display text-2xl text-graphite hover:text-spice transition-colors">
                Phantom Screens
              </a>
            </li>
          </ul>
        </div>
        <ul class="mt-1 divide-y divide-line/60">
          {
            primaryNav
              .filter((item) => item.href !== '/phantom-screens')
              .map((item) => (
                <li>
                  <a href={item.href} class="block py-2.5 font-display text-2xl text-graphite hover:text-spice transition-colors">
                    {item.label}
                  </a>
                </li>
              ))
          }
        </ul>
        <div class="mt-6 flex flex-col gap-3 border-t border-line pt-5">
          <Button href={site.cta.href} size="lg" full>{site.cta.label}</Button>
          <a href={`tel:${site.phoneTel}`} class="text-center text-[14.5px] font-medium text-mist hover:text-spice py-1">
            Call our team: <span class="font-semibold text-graphite">{site.phoneDisplay}</span>
          </a>
        </div>
      </nav>
    </Container>
  </div>
</header>

<style>
  @media (max-width: 1023.98px) {
    .header-cta-desktop {
      display: none !important;
    }
  }

  [data-menu-toggle][aria-expanded='true'] .bar-top {
    transform: translateY(6px) rotate(45deg);
  }
  [data-menu-toggle][aria-expanded='true'] .bar-mid {
    opacity: 0;
    transform: scaleX(0);
  }
  [data-menu-toggle][aria-expanded='true'] .bar-bot {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
