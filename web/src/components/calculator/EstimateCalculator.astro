---
import Icon from '../ui/Icon.astro';

interface Props {
  initialProduct?: string;
  class?: string;
}

const { initialProduct = 'motorized-roller-shades', class: cls } = Astro.props;
---

<div data-estimate-calculator data-initial-product={initialProduct} class:list={['space-y-10', cls]}>
  <!-- Step 1: Select Product -->
  <div>
    <div class="flex items-baseline justify-between">
      <span class="text-[12px] font-semibold tracking-[0.08em] text-mist uppercase">01 / Choose System</span>
      <span class="text-[12px] text-mist">Custom fabricated &amp; motorized</span>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <button
        type="button"
        data-calc-product="motorized-roller-shades"
        class="group flex flex-col justify-between rounded-card border border-line bg-paper p-5 text-left transition hover:border-spice"
        aria-pressed="true"
      >
        <div>
          <div class="flex items-center justify-between">
            <span class="font-display text-xl text-graphite">Roller Shades</span>
            <span class="rounded-full bg-lace px-2 py-0.5 text-[11px] font-medium text-mist">Popular</span>
          </div>
          <p class="mt-2 text-[13px] text-mist">Minimalist fabric panel. Solar, light-filtering or blackout.</p>
        </div>
        <p class="mt-4 text-[12px] font-medium text-spice">From ~$450 / window</p>
      </button>

      <button
        type="button"
        data-calc-product="motorized-dual-shades"
        class="group flex flex-col justify-between rounded-card border border-line bg-lace/60 p-5 text-left transition hover:border-spice"
        aria-pressed="false"
      >
        <div>
          <div class="flex items-center justify-between">
            <span class="font-display text-xl text-graphite">Dual / Zebra</span>
            <span class="rounded-full bg-lace px-2 py-0.5 text-[11px] font-medium text-mist">Versatile</span>
          </div>
          <p class="mt-2 text-[13px] text-mist">Alternating sheer and solid bands for instant view or privacy.</p>
        </div>
        <p class="mt-4 text-[12px] font-medium text-spice">From ~$550 / window</p>
      </button>

      <button
        type="button"
        data-calc-product="motorized-honeycomb-shades"
        class="group flex flex-col justify-between rounded-card border border-line bg-lace/60 p-5 text-left transition hover:border-spice"
        aria-pressed="false"
      >
        <div>
          <div class="flex items-center justify-between">
            <span class="font-display text-xl text-graphite">Honeycomb</span>
            <span class="rounded-full bg-lace px-2 py-0.5 text-[11px] font-medium text-mist">Insulating</span>
          </div>
          <p class="mt-2 text-[13px] text-mist">Cellular air pocket that insulates against winter draft &amp; summer heat.</p>
        </div>
        <p class="mt-4 text-[12px] font-medium text-spice">From ~$520 / window</p>
      </button>

      <button
        type="button"
        data-calc-product="phantom-door-screens"
        class="group flex flex-col justify-between rounded-card border border-line bg-lace/60 p-5 text-left transition hover:border-spice"
        aria-pressed="false"
      >
        <div>
          <div class="flex items-center justify-between">
            <span class="font-display text-xl text-graphite">Phantom Door</span>
            <span class="rounded-full bg-lace px-2 py-0.5 text-[11px] font-medium text-mist">Retractable</span>
          </div>
          <p class="mt-2 text-[13px] text-mist">Discreet retractable screen for hinged, sliding, or French patio doors.</p>
        </div>
        <p class="mt-4 text-[12px] font-medium text-spice">From ~$520 installed</p>
      </button>
    </div>
  </div>

  <!-- Step 2: Dimensions & Quantity -->
  <div class="grid gap-8 lg:grid-cols-2">
    <!-- Window Dimensions -->
    <div class="rounded-card border border-line bg-paper p-6 sm:p-7">
      <div class="flex items-baseline justify-between">
        <span class="text-[12px] font-semibold tracking-[0.08em] text-mist uppercase">02 / Approximate Dimensions</span>
        <span class="text-[12px] text-mist">Laser-measured to ±1/16" by our in-house crew</span>
      </div>

      <!-- Presets -->
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="self-center text-[12px] text-mist">Presets:</span>
        <button
          type="button"
          data-calc-preset
          data-preset-w="36"
          data-preset-h="60"
          class="rounded-btn border border-line bg-lace/50 px-2.5 py-1 text-[12px] font-medium hover:border-graphite"
        >
          Standard (36×60)
        </button>
        <button
          type="button"
          data-calc-preset
          data-preset-w="60"
          data-preset-h="84"
          class="rounded-btn border border-line bg-lace/50 px-2.5 py-1 text-[12px] font-medium hover:border-graphite"
        >
          Condo Wall (60×84)
        </button>
        <button
          type="button"
          data-calc-preset
          data-preset-w="72"
          data-preset-h="72"
          class="rounded-btn border border-line bg-lace/50 px-2.5 py-1 text-[12px] font-medium hover:border-graphite"
        >
          Picture (72×72)
        </button>
        <button
          type="button"
          data-calc-preset
          data-preset-w="96"
          data-preset-h="84"
          class="rounded-btn border border-line bg-lace/50 px-2.5 py-1 text-[12px] font-medium hover:border-graphite"
        >
          Patio Slider (96×84)
        </button>
      </div>

      <!-- Width Slider -->
      <div class="mt-6 space-y-2">
        <div class="flex justify-between text-[14px]">
          <span class="flex items-center gap-1.5 font-medium text-graphite">
            <Icon name="arrows-out-line-horizontal-light" size={16} /> Width
          </span>
          <span data-calc-width-val class="font-display text-lg text-spice">36"</span>
        </div>
        <input
          type="range"
          data-calc-width
          min="24"
          max="120"
          value="36"
          step="1"
          class="h-2 w-full cursor-pointer accent-spice"
        />
        <div class="flex justify-between text-[11px] text-mist">
          <span>24 in</span>
          <span>72 in</span>
          <span>120 in (10 ft)</span>
        </div>
      </div>

      <!-- Height Slider -->
      <div class="mt-6 space-y-2">
        <div class="flex justify-between text-[14px]">
          <span class="flex items-center gap-1.5 font-medium text-graphite">
            <Icon name="arrows-out-line-vertical-light" size={16} /> Height
          </span>
          <span data-calc-height-val class="font-display text-lg text-spice">60"</span>
        </div>
        <input
          type="range"
          data-calc-height
          min="36"
          max="120"
          value="60"
          step="1"
          class="h-2 w-full cursor-pointer accent-spice"
        />
        <div class="flex justify-between text-[11px] text-mist">
          <span>36 in</span>
          <span>72 in</span>
          <span>120 in</span>
        </div>
      </div>
    </div>

    <!-- Window Count & Package -->
    <div class="flex flex-col justify-between rounded-card border border-line bg-paper p-6 sm:p-7">
      <div>
        <div class="flex items-baseline justify-between">
          <span class="text-[12px] font-semibold tracking-[0.08em] text-mist uppercase">03 / Window Count</span>
          <span class="text-[12px] text-mist">Multi-window volume discount</span>
        </div>

        <div class="mt-6 flex items-center gap-6">
          <div class="flex items-center rounded-card border border-line bg-lace/40 p-1">
            <button
              type="button"
              data-calc-count-minus
              aria-label="Decrease window count"
              class="flex h-11 w-11 items-center justify-center rounded-input bg-paper text-xl font-medium text-graphite shadow-sm transition hover:bg-lace"
            >
              −
            </button>
            <span data-calc-count-val class="w-14 text-center font-display text-3xl font-normal text-graphite">3</span>
            <button
              type="button"
              data-calc-count-plus
              aria-label="Increase window count"
              class="flex h-11 w-11 items-center justify-center rounded-input bg-paper text-xl font-medium text-graphite shadow-sm transition hover:bg-lace"
            >
              +
            </button>
          </div>
          <div>
            <p class="text-[14px] font-medium text-graphite">Windows or Openings</p>
            <p class="text-[12px] text-mist">Average Vancouver home: 4–12 motorized shades</p>
          </div>
        </div>

        <div class="mt-6 space-y-2 border-t border-line/60 pt-5 text-[13px] text-mist">
          <div class="flex items-center gap-2">
            <Icon name="check-light" size={16} class="text-spice" />
            <span>4–7 windows: <strong>5% package savings</strong> applied automatically</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="check-light" size={16} class="text-spice" />
            <span>8+ windows: <strong>10% whole-home savings</strong> applied automatically</span>
          </div>
        </div>
      </div>

      <div
        data-calc-discount-badge
        hidden
        class="mt-4 rounded-input border border-honey/50 bg-honey/10 px-3 py-2 text-[12px] font-medium text-mist"
      >
      </div>
    </div>
  </div>

  <!-- Step 3: Power & Controls (Only for Shades) -->
  <div data-shade-only class="grid gap-8 lg:grid-cols-2">
    <!-- Power Option -->
    <div class="rounded-card border border-line bg-paper p-6 sm:p-7">
      <span class="text-[12px] font-semibold tracking-[0.08em] text-mist uppercase">04 / Power Source</span>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <button
          type="button"
          data-calc-power="battery"
          aria-pressed="true"
          class="flex flex-col justify-between rounded-card border border-spice bg-paper p-4 text-left transition hover:border-spice"
        >
          <div>
            <p class="font-display text-lg text-graphite">Rechargeable Li-ion</p>
            <p class="mt-1 text-[12px] text-mist">Concealed in tube. USB-C charge once every 6–9 months. Zero drywall cutting.</p>
          </div>
          <p class="mt-3 text-[12px] font-medium text-mist">Standard (Included)</p>
        </button>

        <button
          type="button"
          data-calc-power="hardwired"
          aria-pressed="false"
          class="flex flex-col justify-between rounded-card border border-line bg-paper p-4 text-left transition hover:border-spice"
        >
          <div>
            <p class="font-display text-lg text-graphite">Hardwired (12V/24V)</p>
            <p class="mt-1 text-[12px] text-mist">Direct low-voltage line. Never recharge batteries. Ideal for renovations or new builds.</p>
          </div>
          <p class="mt-3 text-[12px] font-medium text-mist">+~$75 per window</p>
        </button>
      </div>
    </div>

    <!-- Control Option -->
    <div class="rounded-card border border-line bg-paper p-6 sm:p-7">
      <span class="text-[12px] font-semibold tracking-[0.08em] text-mist uppercase">05 / Control System</span>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <button
          type="button"
          data-calc-control="remote"
          aria-pressed="true"
          class="flex flex-col justify-between rounded-card border border-spice bg-paper p-4 text-left transition hover:border-spice"
        >
          <div>
            <p class="font-display text-lg text-graphite">Handheld Remote</p>
            <p class="mt-1 text-[12px] text-mist">Multi-channel wand for rooms or whole-floor groups.</p>
          </div>
          <p class="mt-3 text-[12px] font-medium text-mist">Included</p>
        </button>

        <button
          type="button"
          data-calc-control="app"
          aria-pressed="false"
          class="flex flex-col justify-between rounded-card border border-line bg-paper p-4 text-left transition hover:border-spice"
        >
          <div>
            <p class="font-display text-lg text-graphite">Smart Hub &amp; App</p>
            <p class="mt-1 text-[12px] text-mist">Schedules, sunrise sync, Apple Home, Google &amp; Alexa.</p>
          </div>
          <p class="mt-3 text-[12px] font-medium text-mist">+~$195 Hub</p>
        </button>

        <button
          type="button"
          data-calc-control="wall"
          aria-pressed="false"
          class="flex flex-col justify-between rounded-card border border-line bg-paper p-4 text-left transition hover:border-spice"
        >
          <div>
            <p class="font-display text-lg text-graphite">Wall Keypad</p>
            <p class="mt-1 text-[12px] text-mist">Flush wireless Decora wall switch in each key room.</p>
          </div>
          <p class="mt-3 text-[12px] font-medium text-mist">+~$85 / room</p>
        </button>
      </div>
    </div>
  </div>

  <!-- Live Ballpark Summary Box -->
  <div class="overflow-hidden rounded-card border-2 border-line bg-lace p-6 md:p-10">
    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <div>
        <span class="text-[12px] font-semibold tracking-[0.1em] text-mist uppercase">Estimated Ballpark Investment</span>
        <div class="mt-2 flex flex-wrap items-baseline gap-3">
          <span data-calc-total-range class="font-display text-[clamp(2.5rem,5vw,4.25rem)] leading-none text-graphite">
            $1,420 – $1,680 CAD
          </span>
        </div>
        <p data-calc-avg-unit class="mt-2 text-[15px] font-medium text-mist">
          ~$475 – $560 per window installed
        </p>

        <ul class="mt-6 grid gap-2.5 text-[13px] text-mist sm:grid-cols-2">
          <li class="flex items-center gap-2">
            <Icon name="check-circle-light" size={17} class="text-spice shrink-0" />
            <span>Precision laser measurement by our crew</span>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="check-circle-light" size={17} class="text-spice shrink-0" />
            <span>Heavy-duty quiet motorized tube &amp; brackets</span>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="check-circle-light" size={17} class="text-spice shrink-0" />
            <span>Professional mounting &amp; limit calibration</span>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="check-circle-light" size={17} class="text-spice shrink-0" />
            <span>5-Year motor &amp; fabric manufacturer warranty</span>
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-4 border-t border-line/70 pt-6 lg:border-t-0 lg:border-l lg:pl-10 lg:pt-0">
        <p class="text-[13px] leading-relaxed text-mist">
          Ready to confirm fabric samples in your home's natural light? Carry this estimate directly into an in-home consultation request.
        </p>
        <a
          href="/quote"
          data-calc-quote-link
          class="flex min-h-12 sm:h-14 w-full items-center justify-center rounded-btn bg-spice px-4 sm:px-6 py-3 text-center text-[13.5px] sm:text-[15px] font-medium tracking-[0.03em] sm:tracking-[0.04em] text-lace shadow-sm transition hover:bg-spice-deep whitespace-nowrap"
        >
          Book Consultation with Estimate →
        </a>
        <p class="text-center text-[12px] text-mist">
          Zero obligation · Transparent itemized quote · Metro Vancouver
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { initEstimateCalculator } from '../../scripts/estimate-calculator';

  document.querySelectorAll<HTMLElement>('[data-estimate-calculator]').forEach((el) => {
    initEstimateCalculator(el);
  });
</script>
