---
import type { Benefit } from '../../data/types';

interface Props {
  items: Benefit[];
  class?: string;
}

const { items, class: cls } = Astro.props;
---

<ol class:list={['grid gap-10 md:grid-cols-3 md:gap-12', cls]}>
  {
    items.map((item, i) => (
      <li class="border-t border-line pt-6" data-reveal data-reveal-delay={String(i * 0.08)}>
        <span class="block text-[13px] font-medium tabular-nums text-mist">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-4 text-h3">{item.title}</h3>
        <p class="mt-3 max-w-[38ch] text-[16px] text-mist">{item.body}</p>
      </li>
    ))
  }
</ol>
