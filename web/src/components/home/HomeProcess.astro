---
import { images } from '../../data/images';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import StockImage from '../ui/StockImage.astro';

const steps = [
  {
    title: 'Consult at home',
    detail: 'We look at each window in its own light and talk about privacy, glare and how you want the room to feel.'
  },
  {
    title: 'Measure & specify',
    detail: 'We measure, bring fabric samples and plan the controls before putting together a clear written quote.'
  },
  {
    title: 'Install & program',
    detail: 'Once installed, we set the limits, group the shades and show you how to use your schedules.'
  }
];
---

<Section tone="band" pad="none" id="process" class="py-20 md:py-28">
  <Container class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-24">
    <div>
      <p class="text-[13px] font-medium text-mist">From first visit to final setting</p>
      <h2 class="mt-6 max-w-[14ch] text-[clamp(2.5rem,4.5vw,4.25rem)] leading-[1.03]">A shade is only as good as the fit.</h2>
      <p class="mt-6 max-w-[40ch] text-mist">We handle the details behind the button: the measure, the fabric, the controls and the way it all works together.</p>
      <StockImage image={images.fabricInset} sizes="(min-width: 1024px) 280px, 45vw" widths={[440, 660, 880]} class="mt-10 aspect-[3/2] w-48 object-cover md:w-72" />
    </div>
    <ol class="border-t border-line">
      {
        steps.map((step, index) => (
          <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-line py-7 md:grid-cols-[4rem_1fr] md:gap-7 md:py-9">
            <span class="pt-1 text-[13px] tabular-nums text-mist">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-[clamp(1.6rem,2.5vw,2.25rem)] leading-[1.1]">{step.title}</h3>
              <p class="mt-3 max-w-[43ch] text-[15px] leading-relaxed text-mist">{step.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>
