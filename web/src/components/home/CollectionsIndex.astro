---
import { phantom } from '../../data/phantom';
import { products } from '../../data/products';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';
import StockImage from '../ui/StockImage.astro';

// Combine the 3 motorized shade products with Phantom Screens into 4 featured collections
const allCollections = [
  ...products.map((p) => ({
    id: p.slug,
    name: p.name,
    shortName: p.shortName,
    tagline: p.tagline,
    description: p.summary,
    bullets: p.benefits.map((b) => b.title),
    image: p.heroImage,
    href: `/products/${p.slug}`,
    calcHref: `/estimate?product=${p.slug}`,
    badge: 'Motorized Shade',
    startingPrice: p.slug === 'motorized-roller-shades' ? 'From ~$450 / window' : p.slug === 'motorized-dual-shades' ? 'From ~$550 / window' : 'From ~$520 / window'
  })),
  {
    id: 'phantom-screens',
    name: 'Phantom Retractable Screens',
    shortName: 'Phantom Screens',
    tagline: phantom.tagline,
    description: phantom.summary,
    bullets: ['Disappears into slim housing', 'Custom color-matched to frames', 'Insect, solar & privacy mesh'],
    image: phantom.heroImage,
    href: '/phantom-screens',
    calcHref: '/estimate?product=phantom-door-screens',
    badge: 'Retractable Door Screen',
    startingPrice: 'From ~$520 installed'
  }
];
---

<Section tone="lace" pad="none" id="collections" class="py-20 md:py-32">
  <Container size="wide">
    <div class="max-w-[56ch]">
      <p class="text-[13px] font-semibold tracking-[0.08em] text-spice uppercase">Our Four Core Collections</p>
      <h2 class="mt-4 text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.02]">
        Designed for West Coast light and living.
      </h2>
      <p class="mt-6 text-[17px] text-mist">
        Every window and door has a distinct purpose. Whether you want filtered daylight over Burrard Inlet, complete bedroom darkness, or fresh patio breezes without bugs, here is how we outfit your home.
      </p>
    </div>

    <!-- 4 Grand Visual Collection Showcases -->
    <div class="mt-16 space-y-16 lg:space-y-24">
      {
        allCollections.map((item, idx) => {
          const isEven = idx % 2 === 1;
          return (
            <article
              class:list={[
                'overflow-hidden rounded-card border border-line bg-paper shadow-sm transition hover:border-graphite/40',
                'grid gap-8 lg:grid-cols-2 lg:items-center'
              ]}
            >
              <!-- Big Visual Image Showcase -->
              <div class:list={['relative overflow-hidden group min-h-[380px] sm:min-h-[460px] lg:min-h-[540px]', isEven && 'lg:order-2']}>
                <StockImage
                  image={item.image}
                  sizes="(min-width: 1024px) 50vw, 100vw"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-graphite/60 via-transparent to-transparent opacity-60"></div>
                
                <!-- Floating Visual Badges -->
                <div class="absolute bottom-5 left-5 right-5 flex flex-wrap items-center justify-between gap-3 text-lace">
                  <span class="rounded-full bg-graphite/80 px-3.5 py-1 text-[12px] font-medium backdrop-blur-xs">
                    {item.badge}
                  </span>
                  <span class="rounded-full bg-spice/90 px-3.5 py-1 text-[12px] font-medium backdrop-blur-xs text-lace">
                    {item.startingPrice}
                  </span>
                </div>
              </div>

              <!-- Content & Details -->
              <div class:list={['p-8 sm:p-12 lg:p-14', isEven && 'lg:order-1']}>
                <div class="flex items-center gap-3">
                  <span class="font-display text-2xl text-graphite/40">0{idx + 1}</span>
                  <span class="h-px flex-1 bg-line"></span>
                </div>

                <h3 class="mt-4 text-[clamp(2rem,3.5vw,3rem)] leading-tight text-graphite">
                  {item.name}
                </h3>
                
                <p class="mt-2 font-display text-xl text-spice italic">
                  “{item.tagline}”
                </p>

                <p class="mt-5 text-[16px] leading-relaxed text-mist">
                  {item.description}
                </p>

                <!-- Key feature bullets -->
                <ul class="mt-6 grid gap-2.5 sm:grid-cols-2 text-[14px] text-graphite">
                  {item.bullets.map((bullet) => (
                    <li class="flex items-center gap-2">
                      <Icon name="check-circle-light" size={17} class="text-spice shrink-0" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>

                <!-- CTAs -->
                <div class="mt-9 flex flex-wrap items-center gap-3 sm:gap-4">
                  <Button href={item.href} size="lg" class="whitespace-nowrap text-[14px] sm:text-[15px]">
                    View {item.shortName}
                  </Button>
                  <Button href={item.calcHref} variant="ghost" size="lg" class="whitespace-nowrap text-[14px] sm:text-[15px]">
                    Estimate pricing
                  </Button>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </Container>
</Section>
